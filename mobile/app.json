{
  "expo": {
    "name": "Feedants Competition",
    "slug": "feedants-competition",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-document-picker",
      "expo-status-bar"
    ],
    "android": {
      "package": "com.feedants.competition"
    },
    "ios": {
      "bundleIdentifier": "com.feedants.competition"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
